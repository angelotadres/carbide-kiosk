#!/bin/bash
# One-time setup: carve the data partition out of the remaining card space,
# then switch the root filesystem to read-only overlayfs and reboot.
#
# Everything else is handled by carbide-kiosk-config on every boot. This script
# only does the two things that cannot be repeated.
set -uo pipefail

# Fail closed: a half-configured firewall or share is worse than none.
CARBIDE_KIOSK_LIB="${CARBIDE_KIOSK_LIB:-/usr/local/lib/carbide-kiosk}"
# shellcheck source=../../02-kiosk-session/files/usr/local/lib/carbide-kiosk/common.sh
. "$CARBIDE_KIOSK_LIB/common.sh" || {
  printf 'carbide-kiosk: cannot load %s/common.sh\n' "$CARBIDE_KIOSK_LIB" >&2
  exit 1
}

DATA_LABEL="CARBIDEDATA"
# Staged outside systemd's search path; see mount_data_partition for why.
UNIT_SOURCE="${CARBIDE_UNIT_SOURCE:-/usr/local/share/carbide-kiosk}"

# First boot takes minutes and the screen is otherwise blank, which invites
# someone to switch the machine off in the middle of formatting. Everything
# below is written to the console the operator is actually looking at.
CONSOLE=/dev/tty1
[ -w "$CONSOLE" ] || CONSOLE=/dev/console

# Also written to the boot partition. It is FAT, so it is the one filesystem
# the operator can read on their own computer - which matters because when
# this step fails there is often no keyboard, no network and no other way to
# find out what happened.
BOOTLOG=/boot/firmware/first-boot.log
say() {
  printf '%s\n' "$*" > "$CONSOLE" 2>/dev/null || printf '%s\n' "$*"
  printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >> "$BOOTLOG" 2>/dev/null || true
}
step() { say ""; say "  [$1/4] $2"; }

# Run a command and capture everything it says into the boot log. When one of
# these tools half-succeeds, its own output is the only thing that explains
# why, and it otherwise goes to a journal nobody can reach.
logged() {
  local out rc
  out="$("$@" 2>&1)"; rc=$?
  if [ -n "$out" ]; then
    printf '  | %s\n' "$out" >> "$BOOTLOG" 2>/dev/null || true
  fi
  printf '  (exit %s) %s\n' "$rc" "$*" >> "$BOOTLOG" 2>/dev/null || true
  return $rc
}

# A snapshot of the things that turn out to matter when this goes wrong.
snapshot() {
  {
    printf '\n--- %s ---\n' "$1"
    df -h / /boot/firmware /data 2>/dev/null
    printf 'partitions:\n'; lsblk -o NAME,SIZE,FSTYPE,LABEL 2>/dev/null | sed 's/^/  /'
    printf 'cmdline: %s\n' "$(cat /boot/firmware/cmdline.txt 2>/dev/null)"
    printf 'config initramfs: %s\n' "$(grep -c '^initramfs ' /boot/firmware/config.txt 2>/dev/null)"
    printf 'kernel: %s\n' "$(uname -r)"
  } >> "$BOOTLOG" 2>/dev/null || true
}

# Override the shared kiosk_die so a failure lands on the screen in front of
# the operator, not only in a journal they have no way to read yet.
kiosk_die() {
  kiosk_log "$*"
  say ""
  say "  SETUP FAILED"
  say "    $*"
  say ""
  say "  The machine is safe to switch off. Nothing was lost."
  say "  Report this message to whoever set the machine up."
  say ""
  exit 1
}
DATA_MIN_MB="${DATA_PARTITION_MIN_MB:-2048}"

boot_device() {
  local root part
  root="$(findmnt -no SOURCE /)"
  part="$(lsblk -no PKNAME "$root")"
  printf '/dev/%s\n' "$part"
}

# Where the new partition must start: one MiB past the end of the last
# existing one. Reads parted's machine-readable output, so it is testable
# against captured output without a disk.
data_partition_start_mb() {
  awk -F: '/^[0-9]+:/ { gsub(/MiB/, "", $3); if ($3 + 0 > end) end = $3 + 0 }
           END { if (end > 0) print int(end) + 1 }'
}

# mmcblk0 needs a p before the number; sda does not.
partition_device() {
  case "$1" in
    *[0-9]) printf '%sp%s\n' "$1" "$2" ;;
    *)      printf '%s%s\n'  "$1" "$2" ;;
  esac
}

create_data_partition() {
  local dev start_mb part number size_mb

  step 1 "Checking the card"
  if blkid -L "$DATA_LABEL" >/dev/null 2>&1; then
    say "        already set up"
    kiosk_log "data partition already exists"
    return 0
  fi

  dev="$(boot_device)"
  [ -b "$dev" ] || kiosk_die "could not identify the boot device"

  start_mb="$(parted -sm "$dev" unit MiB print | data_partition_start_mb)"
  [ -n "$start_mb" ] || kiosk_die "could not read the partition table on $dev"

  number="$(( $(parted -sm "$dev" unit MiB print | grep -c '^[0-9]\+:') + 1 ))"

  # Explicit start to 100%. An earlier version used "100% 100%", which parted
  # accepts and turns into a 1 MiB partition at the very end of the card,
  # stranding everything in between.
  say "        creating storage from ${start_mb} MiB onwards"
  step 2 "Preparing storage for your files"
  snapshot "before partitioning"
  logged parted -s -a optimal "$dev" mkpart primary ext4 "${start_mb}MiB" 100% \
    || kiosk_die "could not create the data partition on $dev"
  partprobe "$dev" || true
  udevadm settle
  sleep 2

  part="$(partition_device "$dev" "$number")"
  [ -b "$part" ] || kiosk_die "new partition $part did not appear"

  # A reflashed card still carries the previous run's filesystem: writing an
  # image only rewrites the first few GB, so recreating this partition at the
  # same offset makes the old ext4 superblock - label and all - reappear under
  # it. blkid found nothing earlier because the flash had rewritten the
  # partition table, so the early return above did not fire.
  #
  # On 1.0.0-alpha.24 udev then published that label, a mount unit claimed the
  # device, and mkfs refused with "is mounted; will not make a filesystem
  # here", killing setup. Take the signature off before anything can act on it.
  umount "$part" 2>/dev/null || true
  logged wipefs -a "$part" || kiosk_log "could not wipe old signatures from $part"
  udevadm settle

  # Check the partition itself, not the free space it was cut from. Reporting
  # intended size rather than actual size is what hid this bug last time.
  size_mb="$(( $(blockdev --getsize64 "$part") / 1048576 ))"
  [ "$size_mb" -ge "$DATA_MIN_MB" ] \
    || kiosk_die "data partition is only ${size_mb} MiB, need at least $DATA_MIN_MB MiB"

  # -m 0: no reserved blocks. This holds G-code, not system files, and 5% of
  # a large card is gigabytes given away for nothing.
  say "        formatting ${size_mb} MiB - this is the slow part"
  mkfs.ext4 -F -L "$DATA_LABEL" -m 0 "$part" > "$CONSOLE" 2>&1 \
    || kiosk_die "could not format $part"
  say "        done"

  kiosk_log "created data partition $part (${size_mb} MiB, starting at ${start_mb} MiB)"
}

# Nothing here goes into /etc/fstab, and that is deliberate. overlayroot
# rewrites every ext4 entry in fstab into a read-only mount under
# /media/root-ro with a tmpfs upper layer, which is right for the root
# filesystem and exactly wrong for the partition the share lives on. The
# 2026-09-01 image wrote these two lines to fstab and came up with the whole
# share in RAM: files vanished on reboot, the share advertised 3.9 GB of
# memory instead of 230 GB of card, and the 230 GB partition sat read-only
# receiving nothing. data.mount and var-log-journal.mount say the same thing
# somewhere overlayroot does not rewrite.
mount_data_partition() {
  install -d -m 755 "$KIOSK_DATA"
  logged mount -t ext4 -o defaults,noatime,commit=1,errors=remount-ro \
    "LABEL=$DATA_LABEL" "$KIOSK_DATA" \
    || kiosk_die "could not mount $KIOSK_DATA"

  install -d -m 2755 -o root -g systemd-journal "$KIOSK_DATA/log/journal"
  logged mount --bind "$KIOSK_DATA/log/journal" /var/log/journal \
    || kiosk_log "could not bind the journal directory"
  install -d -m 755 "$KIOSK_DATA/kiosk/config" "$KIOSK_DATA/kiosk/share"
  chown -R kiosk:kiosk "$KIOSK_DATA/kiosk"
  install -d -m 700 "$KIOSK_DATA/ssh"

  # Installed here, not by the image, and this is load bearing. Three units
  # declare RequiresMountsFor=/data, and that pulls in whichever mount unit
  # covers the path with a hard Requires whether or not it is enabled. Present
  # from the start, data.mount therefore made every first boot wait ninety
  # seconds on a device no partition had been created for yet - which is what
  # 1.0.0-alpha.24 did. Staged out of systemd's search path, there is nothing
  # to require until this line runs, and by now the partition is mounted.
  #
  # This runs before enable_readonly_root, so /etc is still the real
  # filesystem and these survive the overlay.
  install -m 644 "$UNIT_SOURCE/data.mount" /etc/systemd/system/data.mount
  install -m 644 "$UNIT_SOURCE/var-log-journal.mount" \
    /etc/systemd/system/var-log-journal.mount
  # Never --now: this is a unit systemd is still starting, for the reason
  # carbide-kiosk-access documents at length. Both are already mounted by hand
  # above, so there is nothing to start anyway.
  logged systemctl enable data.mount var-log-journal.mount \
    || kiosk_log "could not enable the data mount units"
}

# Which initramfs the firmware will actually load, printed if one will be.
#
# Two mechanisms exist and this base image uses the second. An explicit
# "initramfs <file> followkernel" line in config.txt names one outright. With
# auto_initramfs=1 the firmware instead picks the file matching the kernel it
# is booting and raspi-config leaves config.txt alone - so looking only for
# the explicit line reported a correctly installed overlay as incomplete and
# reverted a working machine to a writable root.
# The two parameters exist so tests/overlay_initramfs.bats can point this at a
# temporary boot directory and name a kernel release. Production calls take
# the defaults, which is what shellcheck is objecting to.
# shellcheck disable=SC2120
overlay_initramfs() {
  local bootdir="${1:-/boot/firmware}" release="${2:-$(uname -r)}"
  local config="$bootdir/config.txt" name

  name="$(awk '/^[[:space:]]*initramfs[[:space:]]/{print $2; exit}' "$config" 2>/dev/null)"
  if [ -z "$name" ] && grep -qE '^[[:space:]]*auto_initramfs=1' "$config" 2>/dev/null; then
    # The firmware's own suffixes. v7l is checked before v7 because it would
    # otherwise match the shorter pattern and name the wrong file.
    case "$release" in
      *-v7l*) name=initramfs7l ;;
      *-v8*)  name=initramfs8 ;;
      *-v7*)  name=initramfs7 ;;
      *)      name=initramfs ;;
    esac
  fi

  [ -n "$name" ] && [ -f "$bootdir/$name" ] && printf '%s\n' "$name"
}

# Whether the overlay machinery is actually installed. raspi-config's
# enable_overlayfs is a wrapper over the overlayroot package and installs it
# from the network at the moment it is asked to. On a first boot with no
# network that apt fails, raspi-config exits 0 regardless, and the machine
# comes up writable with overlayroot=tmpfs on its kernel command line and
# nothing installed to act on it - which is what happened on 2026-08-30 and
# was reported as success. Both packages are baked into the image now, so this
# is a guard against a build that lost them, not a routine failure path.
overlay_packages_installed() {
  local pkg
  for pkg in overlayroot cryptsetup; do
    [ "$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null)" = "install ok installed" ] \
      || return 1
  done
}

# Whether an initramfs actually carries the overlay hook. Separate from the
# caller so tests can point it at a fixture: every image ships an initramfs,
# so testing that a file exists passes on the one the build wrote and says
# nothing about whether the overlay is inside it.
overlay_hook_present() {
  lsinitramfs "$1" 2>/dev/null | grep -q overlayroot
}

enable_readonly_root() {
  local cmdline=/boot/firmware/cmdline.txt
  step 3 "Making the system read-only"
  say "        building the boot image, please wait"

  # Order matters: enable_bootro refuses to edit fstab once the overlay is
  # live, so the boot partition is marked read-only first.
  snapshot "before making the system read-only"
  logged raspi-config nonint enable_bootro \
    || kiosk_die "could not mark the boot partition read-only"

  local initrd ok=yes

  if ! overlay_packages_installed; then
    # Nothing to be gained by asking raspi-config: it would fetch them, fail
    # without a network, and report success.
    kiosk_log "overlayroot or cryptsetup is not installed; not attempting the overlay"
    ok=no
  else
    # raspi-config builds the overlay initramfs and adds overlayroot=tmpfs to
    # the kernel command line. Whether it also names the initramfs in
    # config.txt depends on the base image; this one relies on
    # auto_initramfs=1 instead.
    logged raspi-config nonint enable_overlayfs || kiosk_die "could not enable overlayfs"
    snapshot "after enabling overlayfs"

    # Checking cmdline alone is not enough, and getting that wrong produced a
    # machine that would not boot at all: the kernel told to mount an overlay
    # root by machinery that was never installed hangs before anything can
    # report it. All three halves have to be there - the parameter, an
    # initramfs the firmware will really load, and the overlay hook inside
    # that initramfs. The third is the one that was missing: every image
    # ships an initramfs, so testing only that a file exists passes on the
    # one the build wrote and proves nothing about the overlay.
    grep -q 'overlayroot=tmpfs' "$cmdline" 2>/dev/null || ok=no
    initrd="$(overlay_initramfs)"
    [ -n "$initrd" ] || ok=no
    if [ -n "$initrd" ] && ! overlay_hook_present "/boot/firmware/$initrd"; then
      kiosk_log "initramfs '$initrd' carries no overlayroot hook"
      ok=no
    fi
  fi

  if [ "$ok" != "yes" ]; then
    # Leave the machine bootable. A writable root is a compromise; a machine
    # that cannot start is not.
    sed -i -E 's| ?overlayroot=tmpfs||g' "$cmdline" 2>/dev/null
    say ""
    say "  WARNING: could not make the system read-only."
    say "    The machine will still work, but an unclean shutdown"
    say "    could corrupt it. Report this."
    say ""
    kiosk_log "overlay setup incomplete (initramfs '${initrd:-none}'); reverted to a writable root"
    return 0
  fi

  say "        done"
  kiosk_log "root filesystem will be read-only after reboot"
}

main() {
  say ""
  say "  ================================================"
  say "    Carbide Motion Kiosk - first time setup"
  say "  ================================================"
  say ""
  say "    This runs once and takes a few minutes."
  say "    The machine will restart itself when done."
  say ""
  say "    DO NOT SWITCH OFF."
  say ""

  create_data_partition
  mount_data_partition
  enable_readonly_root
  snapshot "final state before reboot"
  logged systemctl disable carbide-firstboot.service
  step 4 "Restarting"
  say ""
  say "    Setup finished. Restarting now."
  say ""
  sleep 3
  kiosk_log "first boot complete, rebooting"
  systemctl reboot
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi

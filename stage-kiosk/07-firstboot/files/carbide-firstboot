#!/bin/bash
# One-time setup: carve the data partition out of the remaining card space,
# then switch the root filesystem to read-only overlayfs and reboot.
#
# Everything else is handled by carbide-kiosk-config on every boot. This script
# only does the two things that cannot be repeated.
set -uo pipefail

# Fail closed: a half-configured firewall or share is worse than none.
CARBIDE_KIOSK_LIB="${CARBIDE_KIOSK_LIB:-/usr/local/lib/carbide-kiosk}"
# shellcheck source=../../02-kiosk-session/files/usr/local/lib/carbide-kiosk/common.sh
. "$CARBIDE_KIOSK_LIB/common.sh" || {
  printf 'carbide-kiosk: cannot load %s/common.sh\n' "$CARBIDE_KIOSK_LIB" >&2
  exit 1
}

DATA_LABEL="CARBIDEDATA"
DATA_MIN_MB="${DATA_PARTITION_MIN_MB:-2048}"

boot_device() {
  local root part
  root="$(findmnt -no SOURCE /)"
  part="$(lsblk -no PKNAME "$root")"
  printf '/dev/%s\n' "$part"
}

# Where the new partition must start: one MiB past the end of the last
# existing one. Reads parted's machine-readable output, so it is testable
# against captured output without a disk.
data_partition_start_mb() {
  awk -F: '/^[0-9]+:/ { gsub(/MiB/, "", $3); if ($3 + 0 > end) end = $3 + 0 }
           END { if (end > 0) print int(end) + 1 }'
}

# mmcblk0 needs a p before the number; sda does not.
partition_device() {
  case "$1" in
    *[0-9]) printf '%sp%s\n' "$1" "$2" ;;
    *)      printf '%s%s\n'  "$1" "$2" ;;
  esac
}

create_data_partition() {
  local dev start_mb part number size_mb

  if blkid -L "$DATA_LABEL" >/dev/null 2>&1; then
    kiosk_log "data partition already exists"
    return 0
  fi

  dev="$(boot_device)"
  [ -b "$dev" ] || kiosk_die "could not identify the boot device"

  start_mb="$(parted -sm "$dev" unit MiB print | data_partition_start_mb)"
  [ -n "$start_mb" ] || kiosk_die "could not read the partition table on $dev"

  number="$(( $(parted -sm "$dev" unit MiB print | grep -c '^[0-9]\+:') + 1 ))"

  # Explicit start to 100%. An earlier version used "100% 100%", which parted
  # accepts and turns into a 1 MiB partition at the very end of the card,
  # stranding everything in between.
  parted -s -a optimal "$dev" mkpart primary ext4 "${start_mb}MiB" 100% \
    || kiosk_die "could not create the data partition on $dev"
  partprobe "$dev" || true
  udevadm settle
  sleep 2

  part="$(partition_device "$dev" "$number")"
  [ -b "$part" ] || kiosk_die "new partition $part did not appear"

  # Check the partition itself, not the free space it was cut from. Reporting
  # intended size rather than actual size is what hid this bug last time.
  size_mb="$(( $(blockdev --getsize64 "$part") / 1048576 ))"
  [ "$size_mb" -ge "$DATA_MIN_MB" ] \
    || kiosk_die "data partition is only ${size_mb} MiB, need at least $DATA_MIN_MB MiB"

  # -m 0: no reserved blocks. This holds G-code, not system files, and 5% of
  # a large card is gigabytes given away for nothing.
  mkfs.ext4 -F -q -L "$DATA_LABEL" -m 0 "$part" \
    || kiosk_die "could not format $part"

  kiosk_log "created data partition $part (${size_mb} MiB, starting at ${start_mb} MiB)"
}

mount_data_partition() {
  install -d -m 755 "$KIOSK_DATA"
  grep -q "$DATA_LABEL" /etc/fstab || printf \
    'LABEL=%s\t%s\text4\tdefaults,noatime,commit=1,errors=remount-ro\t0\t2\n' \
    "$DATA_LABEL" "$KIOSK_DATA" >> /etc/fstab
  mount "$KIOSK_DATA" || kiosk_die "could not mount $KIOSK_DATA"

  install -d -m 2755 -o root -g systemd-journal "$KIOSK_DATA/log/journal"
  grep -q '/var/log/journal' /etc/fstab || printf \
    '%s/log/journal\t/var/log/journal\tnone\tbind\t0\t0\n' "$KIOSK_DATA" >> /etc/fstab
  mount /var/log/journal || kiosk_log "could not bind the journal directory"
  install -d -m 755 "$KIOSK_DATA/kiosk/config" "$KIOSK_DATA/kiosk/share"
  chown -R kiosk:kiosk "$KIOSK_DATA/kiosk"
  install -d -m 2755 -o root -g systemd-journal "$KIOSK_DATA/log/journal"
  install -d -m 700 "$KIOSK_DATA/ssh"
}

enable_readonly_root() {
  local cmdline=/boot/firmware/cmdline.txt

  # Order matters: enable_bootro refuses to edit fstab once the overlay is
  # live, so the boot partition is marked read-only first.
  raspi-config nonint enable_bootro \
    || kiosk_die "could not mark the boot partition read-only"

  # raspi-config builds the overlay initramfs, points config.txt at it, and
  # adds overlayroot=tmpfs to the kernel command line.
  raspi-config nonint enable_overlayfs || kiosk_die "could not enable overlayfs"

  # The read-only root is the whole point of this image. A silently writable
  # root that looks protected is the one outcome worth refusing to boot into.
  [ -r "$cmdline" ] || kiosk_die "$cmdline is missing; cannot confirm the overlay"
  grep -q 'overlayroot=tmpfs' "$cmdline" \
    || kiosk_die "overlayfs did not take effect; refusing to continue with a writable root"

  kiosk_log "root filesystem will be read-only after reboot"
}

main() {
  create_data_partition
  mount_data_partition
  enable_readonly_root
  systemctl disable carbide-firstboot.service
  kiosk_log "first boot complete, rebooting"
  systemctl reboot
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi

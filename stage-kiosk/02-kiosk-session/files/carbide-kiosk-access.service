[Unit]
Description=Carbide Motion Kiosk remote access
Documentation=https://github.com/angelotadres/carbide-kiosk
# The first thing this image does, and the only one whose failure nothing can
# be diagnosed around. Everything else on this machine can fail; if this has
# run, the machine can still be reached and looked at.
#
# NetworkManager only, deliberately not network.target. This unit brings the
# network up rather than waiting for it, and waiting would close a cycle:
# network.target comes after network-pre.target, which comes after
# nftables.service, which the configuration step is ordered before.
After=NetworkManager.service
Before=carbide-firstboot.service carbide-kiosk-config.service
# No ConditionPathExists. Gating this on kiosk.conf meant a fresh flash - which
# has no kiosk.conf until someone copies one onto the card - skipped the unit
# entirely, and systemd reports a skipped condition as success. The result was
# an unreachable machine with nothing anywhere saying why. The script handles
# a missing config file itself, out loud.
#
# No RequiresMountsFor either: if /boot/firmware is not mounted the script can
# still open port 22, and being able to log in and see that is the point.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/carbide-kiosk-access
# Bounded, so a stalled step cannot hold the boot. Failure is deliberately
# not masked: SuccessExitStatus=0 1 once made an exit that never opened the
# port look like a success, which is the one outcome nobody could see.
#
# This has to exceed what every bounded step in the script can spend between
# them, or the unit is killed part way through and the steps below the hang
# never run - which is how a wifi-only machine came up with no network at all.
# tests/units.bats adds the script's own timeouts up and fails if they no
# longer fit. Nothing here waits this long in practice: a healthy boot spends
# a few seconds, and the ceiling only matters when something is already wrong.
TimeoutStartSec=240
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target

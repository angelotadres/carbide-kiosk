[Unit]
Description=Apply Carbide Motion Kiosk runtime configuration
Documentation=https://github.com/angelotadres/carbide-kiosk
# Not network-pre.target: nftables.service is ordered before it, and this
# unit is ordered before nftables, which is a cycle systemd resolves by
# silently dropping edges.
After=local-fs.target carbide-firstboot.service
# Not nftables.service: it is ordered before network-pre.target, and being
# ordered before it closes a cycle back through this unit. The ruleset is
# loaded here directly anyway, and the one shipped in the image is closed, so
# whichever runs first the machine is never briefly open.
Before=smbd.service nmbd.service ssh.service carbide-kiosk.service
RequiresMountsFor=/boot/firmware /data
ConditionPathExists=/boot/firmware/kiosk.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/carbide-kiosk-config
# No single step of applying a config file is worth hanging a boot over. If
# this cannot finish in two minutes something is wrong with it, and the
# machine is more useful running with partial settings than not running.
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

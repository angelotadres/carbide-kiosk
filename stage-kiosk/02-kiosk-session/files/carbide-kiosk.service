[Unit]
Description=Carbide Motion kiosk session
Documentation=https://github.com/angelotadres/carbide-kiosk
After=carbide-kiosk-config.service systemd-user-sessions.service
Requires=carbide-kiosk-config.service
RequiresMountsFor=/data
Conflicts=getty@tty1.service
After=getty@tty1.service

# If the session cannot start, stop trying. Restarting every two seconds
# steals the display and the keyboard, which makes the machine impossible to
# diagnose at exactly the moment someone needs to.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
# So Carbide Motion's file dialog opens on the share rather than the home
# directory, which holds nothing a person put there.
WorkingDirectory=/data/gcode
ExecStart=/usr/bin/xinit /usr/local/bin/carbide-kiosk-xsession -- :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

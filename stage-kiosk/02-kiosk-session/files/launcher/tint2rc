# A single button in the bottom-right corner that shows and hides the
# keyboard. Deliberately not a taskbar: the machine runs one application and
# a list of windows would only invite someone to close it.
panel_items = L
panel_size = 84 84
panel_margin = 0 0
panel_padding = 6 6 0
panel_position = bottom right horizontal
panel_layer = top
panel_background_id = 1
strut_policy = none
autohide = 0
wm_menu = 0

launcher_icon_size = 64
launcher_padding = 4 4 0
launcher_background_id = 0
launcher_icon_theme_override = 0
launcher_item_app = /etc/xdg/carbide/carbide-keyboard.desktop
launcher_tooltip = 0

rounded = 6
border_width = 2
background_color = #202020 85
border_color = #e8b21a 90

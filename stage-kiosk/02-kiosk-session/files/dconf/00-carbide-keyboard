# System defaults for the on-screen keyboard. Set here rather than per-user
# because the user's dconf database lives on the volatile overlay and would
# be discarded at every reboot.
[org/onboard]
layout='Compact'

# Start as the icon, not the keyboard. Auto-show is deliberately off: it
# relies on the application publishing focused text fields over accessibility,
# and Carbide Motion does not, so the keyboard simply never appeared. Tapping
# a visible icon always works.
start-minimized=true

[org/onboard/auto-show]
enabled=false

[org/onboard/window]
docking-enabled=false
force-to-top=true
# A full border of grab handles rather than one small move button: on a touch
# panel a single-button target is hard to hit with a finger.
window-handles='NSEWnsewM'
enable-inactive-transparency=false

[org/onboard/window/landscape]
x=480
y=800
width=950
height=330

[org/onboard/icon-palette]
in-use=true

[org/onboard/icon-palette/landscape]
x=1780
y=1080
width=110
height=110

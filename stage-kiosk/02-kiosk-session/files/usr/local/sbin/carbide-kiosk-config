#!/bin/bash
# Regenerate all runtime configuration from kiosk.conf.
#
# The root filesystem is read-only with a tmpfs overlay, so everything this
# script writes under /etc is discarded at shutdown. That is deliberate: the
# single source of truth is kiosk.conf on the boot partition, and editing it
# from any machine with an SD card reader is the whole administration story.
set -uo pipefail

# Fail closed: a half-configured firewall or share is worse than none.
CARBIDE_KIOSK_LIB="${CARBIDE_KIOSK_LIB:-/usr/local/lib/carbide-kiosk}"
# shellcheck source=../lib/carbide-kiosk/common.sh
. "$CARBIDE_KIOSK_LIB/common.sh" || {
  printf 'carbide-kiosk: cannot load %s/common.sh\n' "$CARBIDE_KIOSK_LIB" >&2
  exit 1
}

# The share owner's UID is fixed so that renaming the account in kiosk.conf
# does not orphan every file already on the data partition.
SHARE_UID=1500
SHARE_GID=1500

# Render-only mode writes and validates every generated file but applies
# nothing, so CI can check the real generator instead of a copy of it.
RENDER_ONLY="${CARBIDE_KIOSK_RENDER_ONLY:-0}"
OUT="${CARBIDE_KIOSK_ROOT:-}"

rendering() { [ "$RENDER_ONLY" = "1" ]; }

# Anything that talks to another daemon can wait forever when that daemon is
# not ready. During boot that stalls the whole machine, so nothing here is
# allowed to run unbounded.
bounded() {
  local secs="$1"; shift
  timeout --foreground "$secs" "$@" || {
    kiosk_log "timed out or failed after ${secs}s: $*"
    return 1
  }
}
outfile() { printf '%s%s\n' "$OUT" "$1"; }

configure_hostname() {
  local name
  name="$(kiosk_get hostname carbide-kiosk)"
  if ! kiosk_valid_hostname "$name"; then
    kiosk_log "hostname '$name' is not valid, keeping carbide-kiosk"
    name="carbide-kiosk"
  fi
  printf '%s\n' "$name" > "$(outfile /etc/hostname)"
  printf '127.0.1.1\t%s\n' "$name" >> "$(outfile /etc/hosts)"
  rendering || bounded 20 hostnamectl set-hostname "$name"
}

# The image is built with UTC because a build server has no idea where the
# machine will end up. The clock itself is correct and NTP-synced; only the
# displayed time is wrong until this is set.
configure_timezone() {
  local tz
  tz="$(kiosk_get timezone)"
  [ -n "$tz" ] || return 0
  if [ ! -f "/usr/share/zoneinfo/$tz" ]; then
    kiosk_log "timezone '$tz' is not a known zone, leaving the clock on UTC"
    return 0
  fi
  rendering && return 0
  bounded 20 timedatectl set-timezone "$tz" || kiosk_log "could not set the timezone"
}

configure_wifi() {
  local ssid psk country conn
  ssid="$(kiosk_get wifi_ssid)"
  [ -n "$ssid" ] || { kiosk_log "no wifi_ssid set, assuming wired"; return 0; }
  psk="$(kiosk_get wifi_password)"
  country="$(kiosk_get wifi_country US)"

  rendering || bounded 30 raspi-config nonint do_wifi_country "$country" \
    || kiosk_log "could not set wifi country"

  conn="$(outfile /etc/NetworkManager/system-connections/carbide-kiosk.nmconnection)"
  install -d -m 700 "$(outfile /etc/NetworkManager/system-connections)"
  {
    printf '[connection]\nid=carbide-kiosk\ntype=wifi\nautoconnect=true\n\n'
    printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
    if [ -n "$psk" ]; then
      printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$psk"
    fi
    printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
  } > "$conn"
  chmod 600 "$conn"
  rendering || bounded 20 nmcli connection reload || kiosk_log "NetworkManager reload failed"
}

configure_share_account() {
  local user password
  user="$(kiosk_get samba_user)"
  password="$(kiosk_get samba_password)"

  if [ -z "$user" ] || [ -z "$password" ]; then
    kiosk_die "samba_user and samba_password are required in $KIOSK_CONF; the share will not start"
  fi

  rendering && return 0

  getent group "$SHARE_GID" >/dev/null || groupadd --gid "$SHARE_GID" cncshare
  if ! getent passwd "$user" >/dev/null; then
    useradd --uid "$SHARE_UID" --gid "$SHARE_GID" --no-create-home \
            --shell /usr/sbin/nologin "$user" \
      || kiosk_die "could not create share account '$user'"
  fi

  # Set unconditionally: kiosk.conf is authoritative, and the Samba account
  # database lives on the volatile overlay anyway.
  printf '%s\n%s\n' "$password" "$password" | smbpasswd -s -a "$user" >/dev/null \
    || kiosk_die "could not set the Samba password for '$user'"
  smbpasswd -e "$user" >/dev/null

  # Carbide Motion runs as kiosk. Without this it cannot open the share
  # directory at all, and files copied over the network are invisible to it.
  usermod -aG cncshare kiosk 2>/dev/null || kiosk_log "could not add kiosk to cncshare"
}

configure_samba() {
  local user share min_proto encrypt
  user="$(kiosk_get samba_user)"
  share="$(kiosk_get samba_share_name gcode)"
  min_proto="$(kiosk_get samba_min_protocol SMB3)"
  encrypt="$(kiosk_get samba_encrypt required)"

  if rendering; then
    install -d -m 755 "$(outfile /etc/samba)"
  else
    install -d -m 2770 -o "$SHARE_UID" -g "$SHARE_GID" "$KIOSK_DATA/$share"
  fi

  cat > "$(outfile /etc/samba/smb.conf)" <<SMB
# Generated from $KIOSK_CONF on every boot. Edits here do not survive a reboot.
[global]
   workgroup = WORKGROUP
   server string = Carbide Motion Kiosk
   server role = standalone server
   security = user
   map to guest = never
   guest ok = no
   restrict anonymous = 2

   server min protocol = $min_proto
   smb encrypt = $encrypt

   # Interfaces are not restricted here; nftables is the single place where
   # reachability is decided.
   disable netbios = no
   dns proxy = no

   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

   # A CNC file that is half-written when the power goes is worse than one
   # that never arrived, so writes are not allowed to sit in cache.
   strict sync = yes
   sync always = yes

[$share]
   comment = G-code for the Shapeoko
   path = $KIOSK_DATA/$share
   browseable = yes
   read only = no
   valid users = $user
   force user = $user
   force group = cncshare
   create mask = 0664
   directory mask = 2775
   veto files = /.DS_Store/._*/.Spotlight-V100/.Trashes/Thumbs.db/
   delete veto files = yes
SMB

  testparm -s "$(outfile /etc/samba/smb.conf)" >/dev/null 2>&1 \
    || kiosk_die "generated smb.conf is not valid"
}

configure_firewall() {
  local ruleset
  ruleset="$(outfile /etc/nftables.conf)"

  {
    printf '#!/usr/sbin/nft -f\n'
    printf '# Generated from %s on every boot.\n\n' "$KIOSK_CONF"
    printf 'flush ruleset\n\n'
    printf 'table inet filter {\n'
    printf '  chain input {\n'
    printf '    type filter hook input priority filter; policy drop;\n\n'
    printf '    iif lo accept\n'
    printf '    ct state established,related accept\n'
    printf '    ct state invalid drop\n\n'
    printf '    # Samba: the one service this image deliberately exposes.\n'
    printf '    tcp dport { 139, 445 } accept\n'
    printf '    udp dport { 137, 138 } accept\n\n'
    printf '    # DHCP replies, needed to hold an address at all.\n'
    printf '    udp sport 67 udp dport 68 accept\n'
    printf '    ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept\n'

    if kiosk_enabled enable_ssh \
       && { [ -n "$(kiosk_get ssh_authorized_key)" ] || [ -n "$(kiosk_get ssh_password)" ]; }; then
      printf '\n    # enable_ssh=1 with a credential set.\n'
      printf '    # Brute force is the realistic attack on an exposed port, so\n'
      printf '    # new connections are rate limited. An established session is\n'
      printf '    # already accepted by the conntrack rule above.\n'
      printf '    tcp dport 22 ct state new limit rate 6/minute burst 3 packets accept\n'
    fi
    if kiosk_enabled enable_mdns; then
      printf '\n    # enable_mdns=1\n    udp dport 5353 accept\n'
    fi
    if kiosk_enabled enable_ping; then
      printf '\n    # enable_ping=1\n'
      printf '    icmp type echo-request accept\n'
      printf '    icmpv6 type echo-request accept\n'
    fi

    printf '  }\n\n'
    printf '  chain forward {\n'
    printf '    type filter hook forward priority filter; policy drop;\n'
    printf '  }\n\n'
    printf '  chain output {\n'
    printf '    type filter hook output priority filter; policy accept;\n'
    printf '  }\n'
    printf '}\n'
  } > "$ruleset"

  nft -c -f "$ruleset" || kiosk_die "generated nftables ruleset is not valid"
  rendering && return 0
  nft -f "$ruleset" || kiosk_die "could not load the nftables ruleset"
  if kiosk_enabled enable_mdns; then
    systemctl enable --now avahi-daemon 2>/dev/null || kiosk_log "avahi is not installed"
  else
    systemctl disable --now avahi-daemon 2>/dev/null
  fi
}

# SSH is off unless kiosk.conf says otherwise, and kiosk.conf can only be
# changed by taking the card out of the machine. Opening the door is therefore
# always a physical act, which is the property worth keeping.
configure_ssh() {
  local key password dropin=/etc/ssh/sshd_config.d/carbide-kiosk.conf
  local hostkey="$KIOSK_DATA/ssh/ssh_host_ed25519_key"

  if ! kiosk_enabled enable_ssh; then
    rendering || systemctl disable --now ssh 2>/dev/null
    return 0
  fi

  key="$(kiosk_get ssh_authorized_key)"
  password="$(kiosk_get ssh_password)"

  if [ -z "$key" ] && [ -z "$password" ]; then
    kiosk_log "enable_ssh=1 but neither ssh_authorized_key nor ssh_password is set"
    kiosk_log "refusing to open port 22 onto an account nobody can log into"
    rendering || systemctl disable --now ssh 2>/dev/null
    return 0
  fi

  install -d -m 755 "$(outfile /etc/ssh/sshd_config.d)"
  {
    printf '# Generated from %s on every boot.\n' "$KIOSK_CONF"
    printf 'PermitRootLogin no\n'
    printf 'PermitEmptyPasswords no\n'
    printf 'KbdInteractiveAuthentication no\n'
    printf 'X11Forwarding no\n'
    printf 'AllowTcpForwarding no\n'
    printf 'AllowAgentForwarding no\n'
    printf 'MaxAuthTries 3\n'
    printf 'MaxSessions 2\n'
    printf 'LoginGraceTime 20\n'
    printf 'AllowUsers kiosk\n'
    # /etc is on the volatile overlay, so a host key generated there would
    # change on every boot and every client would report it as an attack.
    printf 'HostKey %s\n' "$hostkey"
    if [ -n "$key" ]; then
      printf 'PasswordAuthentication no\n'
      printf 'PubkeyAuthentication yes\n'
    else
      printf 'PasswordAuthentication yes\n'
    fi
  } > "$(outfile "$dropin")"

  rendering && return 0

  install -d -m 700 "$KIOSK_DATA/ssh"
  [ -f "$hostkey" ] || ssh-keygen -t ed25519 -N '' -f "$hostkey" -q
  chmod 600 "$hostkey"

  if [ -n "$key" ]; then
    install -d -m 700 -o kiosk -g kiosk /home/kiosk/.ssh
    printf '%s\n' "$key" > /home/kiosk/.ssh/authorized_keys
    chmod 600 /home/kiosk/.ssh/authorized_keys
    chown kiosk:kiosk /home/kiosk/.ssh/authorized_keys
    kiosk_log "ssh enabled, key only"
  else
    printf 'kiosk:%s\n' "$password" | chpasswd
    kiosk_log "ssh enabled with a password; prefer ssh_authorized_key"
  fi

  systemctl enable --now ssh 2>/dev/null || kiosk_log "could not start sshd"
}

configure_cnc_udev() {
  local rule extra id
  rule="$(outfile /etc/udev/rules.d/60-carbide-cnc.rules)"

  extra="$(kiosk_get usb_vendor_ids)"

  {
    printf '# Generated from %s on every boot.\n' "$KIOSK_CONF"
    if [ -z "$extra" ]; then
      # Any USB serial device. A dedicated CNC kiosk has exactly one, no
      # published list of Carbide board identifiers exists, and being absent
      # from an allowlist made the status display report a working machine
      # as unplugged.
      printf 'SUBSYSTEM=="tty", SUBSYSTEMS=="usb", SYMLINK+="shapeoko", GROUP="dialout", MODE="0660", TAG+="uaccess"\n'
    else
      # usb_vendor_ids narrows it, for a machine with a second serial device
      # attached that must not be mistaken for the controller.
      for id in $extra; do
        if kiosk_valid_usb_id "$id"; then
          printf 'SUBSYSTEM=="tty", ATTRS{idVendor}=="%s", SYMLINK+="shapeoko", GROUP="dialout", MODE="0660", TAG+="uaccess"\n' "$id"
        else
          kiosk_log "ignoring malformed usb_vendor_ids entry '$id'"
        fi
      done
    fi
  } > "$rule"

  rendering && return 0
  udevadm control --reload-rules || kiosk_log "udev rule reload failed"
  udevadm trigger --subsystem-match=tty --action=add || true
}


main() {
  [ -r "$KIOSK_CONF" ] || kiosk_die "$KIOSK_CONF is missing; nothing can be configured"
  if rendering; then
    [ -n "$OUT" ] || kiosk_die "render-only mode needs CARBIDE_KIOSK_ROOT"
    install -d -m 755 "$OUT/etc/udev/rules.d"
  fi
  configure_hostname
  configure_timezone
  configure_wifi
  configure_share_account
  configure_samba
  configure_ssh
  configure_firewall
  configure_cnc_udev
  kiosk_log "runtime configuration applied"
}

main "$@"

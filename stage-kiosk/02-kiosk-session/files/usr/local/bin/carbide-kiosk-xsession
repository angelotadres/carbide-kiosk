#!/bin/bash
# The X client side of the kiosk session. Started by xinit, which is started by
# carbide-kiosk.service. Exiting here ends the session and systemd restarts it.
set -uo pipefail

# Fail closed: a half-configured firewall or share is worse than none.
CARBIDE_KIOSK_LIB="${CARBIDE_KIOSK_LIB:-/usr/local/lib/carbide-kiosk}"
# shellcheck source=../lib/carbide-kiosk/common.sh
. "$CARBIDE_KIOSK_LIB/common.sh" || {
  printf 'carbide-kiosk: cannot load %s/common.sh\n' "$CARBIDE_KIOSK_LIB" >&2
  exit 1
}

rotation="$(kiosk_get screen_rotation normal)"
resolution="$(kiosk_get screen_resolution)"
scale="$(kiosk_get ui_scale 2)"
keyboard="$(kiosk_get enable_keyboard 1)"
saver_min="$(kiosk_get screensaver_minutes 10)"

output="$(xrandr --query | awk '/ connected/ {print $1; exit}')"
if [ -n "$output" ]; then
  case "$rotation" in
    normal|left|right|inverted)
      xrandr --output "$output" --rotate "$rotation" || kiosk_log "rotation failed"
      ;;
    *)
      kiosk_log "screen_rotation '$rotation' is not one of normal/left/right/inverted"
      ;;
  esac
  if [ -n "$resolution" ]; then
    xrandr --output "$output" --mode "$resolution" \
      || kiosk_log "resolution '$resolution' rejected, keeping autodetected mode"
  fi
fi

# Scales Carbide Motion's interface without dropping the panel's resolution,
# so text stays sharp. Accessibility is what lets the on-screen keyboard
# notice a focused text field.
export QT_SCALE_FACTOR="$scale"
export QT_ACCESSIBILITY=1
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1

# openbox understands window layers, which is what lets the keyboard float
# above a maximised Carbide Motion. matchbox could not do this.
openbox &
# The keyboard must not start before the window manager is managing windows,
# or it comes up unmanaged and cannot be raised or dragged afterwards.
sleep 3

if [ "$keyboard" = "1" ]; then
  kb_geom="$(kiosk_get keyboard_geometry '1100x360+420+760')"
  # No -no-functionkeys: xvkbd rejects that option and exits immediately,
  # which looked exactly like the keyboard failing to appear.
  xvkbd -geometry "$kb_geom" -no-keypad &
  # openbox applies its layer rule when the window appears, but setting the
  # state directly is what actually kept it above a maximised application.
  # Found by class, not through wmctrl's window list: the window is marked
  # skip-taskbar, which is exactly what that list leaves out.
  ( for _ in 1 2 3 4 5; do
      sleep 3
      wid="$(xdotool search --class XVkbd 2>/dev/null | tail -1)"
      if [ -n "$wid" ]; then
        wmctrl -i -r "$wid" -b add,above 2>/dev/null
        xdotool windowraise "$wid" 2>/dev/null
        break
      fi
    done ) &
fi

if [ "$saver_min" = "0" ]; then
  xset s off
  xset -dpms
else
  carbide-kiosk-write-xscreensaver
  xscreensaver -no-splash &
fi

unclutter -idle 3 -root &

# The window manager is not worth restarting on its own; if Carbide Motion
# goes, the whole session goes and systemd brings it back clean.
exec /usr/local/bin/carbidemotion

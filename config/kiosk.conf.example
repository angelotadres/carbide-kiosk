# Carbide Motion Kiosk runtime configuration.
#
# Copy this file to the boot partition of a flashed card as "kiosk.conf" and
# edit it before first boot. Any machine that can read an SD card can change
# these values; nothing here requires a keyboard on the Pi.
#
# Values are shell-style key=value. Quote anything containing spaces.

# --- Identity -----------------------------------------------------------

hostname=carbide-kiosk

# The image is built on UTC. The clock is correct either way and syncs over
# the network; this only decides what the screen shows. Use a zone name such
# as America/Los_Angeles, America/New_York or Europe/Madrid.
timezone=

# --- Samba (required) ---------------------------------------------------
#
# The share does not come up without an account. There is no guest access.

samba_user=cnc
samba_password=
samba_share_name=gcode

# Transport hardening. "required" refuses unencrypted clients; drop to
# "desired" only if something on the shop network cannot negotiate it.
samba_min_protocol=SMB3
samba_encrypt=required

# --- Network ------------------------------------------------------------
#
# Leave the WiFi values empty for a wired connection.

wifi_ssid=
wifi_password=
wifi_country=US

# --- Inbound exceptions -------------------------------------------------
#
# Everything except Samba is dropped. Each setting below opens exactly one
# more thing, and changing any of them means taking the card out of the
# machine - so opening a door always requires physically holding the machine.

# Opens 22/tcp for troubleshooting. Off by default, and it will refuse to open
# unless one of the two credentials below is also set - an open port nobody
# can log into is worse than no port at all.
#
# This machine can move a spindle. Turn it off again when you are done.
enable_ssh=0

# Preferred. Paste one public key line, for example the contents of
# ~/.ssh/id_ed25519.pub. Password login is refused whenever a key is set.
ssh_authorized_key=

# Fallback if you have no key to hand. Stored in clear text on this card, so
# do not reuse samba_password or anything else that matters.
ssh_password=

# Opens 5353/udp so macOS Finder can discover the share by name.
enable_mdns=0

# Answers ICMP echo. Useful when diagnosing a Pi that will not appear.
enable_ping=0

# --- CNC controller -----------------------------------------------------
#
# USB vendor IDs treated as a CNC controller, in addition to the built-in
# list. Space-separated four-digit hex, as printed by lsusb.

usb_vendor_ids=

# --- Display ------------------------------------------------------------
#
# Rotation is one of: normal, left, right, inverted.
# Resolution is left empty to autodetect; set it for panels that misreport.
# Carbide Motion requires at least 1280x1024.

screen_rotation=normal
screen_resolution=

# How much larger to draw Carbide Motion's interface. 1 is unscaled, 2 is
# double size, which suits a high resolution panel at arm's length. Only the
# application scales; the panel keeps its real resolution, so text stays sharp.
ui_scale=2

# --- On-screen keyboard -------------------------------------------------
#
# A floating keyboard for the touch panel. It sits above the application and
# never resizes it. Drag it anywhere by its title bar.

enable_keyboard=1

# Size and position, in the usual X form WIDTHxHEIGHT+X+Y.
keyboard_geometry=1100x360+420+760

# --- Screensaver --------------------------------------------------------
#
# Minutes of no input before the text screensaver appears, and before the
# panel powers down entirely. Set screensaver_minutes to 0 to disable both
# and keep the display on permanently.
#
# The screensaver shows the share address and whether the machine is
# connected, so an idle panel is still telling you something useful.

screensaver_minutes=10
screen_blank_minutes=20

# Heading shown on the screensaver. Empty means use the machine name.
screensaver_message=

# Text size. 5 is readable across a workshop; raise for a smaller panel.
screensaver_text_size=5

# How much the text glows as it lands, in the manner of an old monitor.
# 1 is crisp with no glow at all; 4 is a brief flicker as each character
# appears. This is separate from the scanline look, which is always on.
screensaver_fade=4

# Six-digit hex. Amber is the classic monitor phosphor and is easy on the
# eyes in a dim workshop; #33FF33 gives the green equivalent.
screensaver_colour=#FFB000

# Seconds the text holds before redrawing with current values.
screensaver_refresh_seconds=60
